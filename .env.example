# Copy to .env.local for `vercel dev`, and set the same keys in Vercel > Settings > Environment Variables.
# Never commit real values.

# Groq API key (transcription + summary)
GROQ_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Shared secret the watch sends in the Authorization header
ALERT_API_TOKEN=
