# Copy to .env.local for `vercel dev`, and set the same keys in Vercel > Settings > Environment Variables.
# Never commit real values.

# Shared secret the watch sends as "Authorization: Bearer <token>". Generate a long random string.
ALERT_API_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random string; Telegram sends it back on every webhook call so we know it is really Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Groq API key (transcription + summary). Only lives here, never in the apps.
GROQ_API_KEY=

# Optional: comma-separated Telegram chat ids always notified (useful before the phone app syncs contacts).
DEFAULT_CHAT_IDS=

# Optional: "true" simulates Telegram and Groq (presentation without internet or keys).
DEMO_MODE=false

# Optional overrides
TIME_ZONE=America/Bogota
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
