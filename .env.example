# Copy to .env for local development. In Vercel, set these in Project Settings → Environment Variables.
# Never commit real values.

# Frontend origin allowed by CORS (use * only for local development).
ALLOWED_ORIGIN=http://localhost:5173

# Public URL of the frontend, used to build the alert link sent to contacts.
FRONTEND_URL=http://localhost:5173

# Telegram bot that notifies trusted contacts (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Groq API key for audio transcription and summary (console.groq.com/keys).
GROQ_API_KEY=

# Upstash Redis (created from the Vercel Marketplace; Vercel injects these automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob token for storing audio clips (injected automatically when the store is linked).
BLOB_READ_WRITE_TOKEN=

# Local dev server port.
PORT=3000
